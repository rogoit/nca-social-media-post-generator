---
import Layout from "../layouts/Layout.astro";
import InputPanel from "../components/InputPanel.tsx";
import KeywordConfirm from "../components/KeywordConfirm.tsx";
import GenerationFeed from "../components/GenerationFeed.tsx";
import ErrorBanner from "../components/ErrorBanner.tsx";
---

<Layout title="Social Media Content Generator">
  <main class="max-w-4xl mx-auto py-4 sm:py-10 px-3 sm:px-4">
    <h1 class="text-3xl font-bold text-center mb-6 sm:mb-8">Social Media Content Generator</h1>

    <div class="bg-white p-3 sm:p-6 rounded-lg shadow-md">
      <InputPanel client:load />
      <KeywordConfirm client:load />
      <GenerationFeed client:load />
    </div>

    <ErrorBanner client:load />
  </main>
</Layout>
